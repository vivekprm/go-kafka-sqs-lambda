{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSourceAccountsToAssume",
      "Effect": "Allow",
// We can list the AWS account allowed but need to be updated at orchestration.
      "Principal": {
        "AWS": "*"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/SourceLambdaExecutionRole"
        }
      }
    }
  ]
}
